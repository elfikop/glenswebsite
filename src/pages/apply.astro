---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Apply for Coaching - Requirements & Form" description="Apply for online personal training with Glen Lambe. Read the coaching requirements and fill out the form to start your 12 Week Foundations Program.">
    
    <!-- Sekcja Wymagań (Requirements) -->
    <section id="requirements" class="py-5 mt-4">
        <div class="container">
            <div class="row justify-content-center">
                <div class="col-lg-10">
                    <div class="text-center mb-5">
                        <h1 class="fw-bold text-white">Coaching <span style="color: var(--primary);">Requirements</span></h1>
                        <p class="text-muted fs-5 mt-3">Before joining the <strong>12 Week Foundations Program</strong>, here is what I need to know about you and why it matters for your success.</p>
                    </div>
                    
                    <div class="row g-4 mb-5">
                        <div class="col-md-6">
                            <div class="benefit-card h-100" style="padding: 25px; text-align: left;">
                                <h4 class="mb-3" style="color: var(--primary);">1. Your Main Goal</h4>
                                <p class="text-muted mb-0">Whether you want to focus on fat loss, building muscle, or general fitness, knowing your primary objective allows me to build a highly optimized, custom training and nutrition plan tailored specifically to your body.</p>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="benefit-card h-100" style="padding: 25px; text-align: left;">
                                <h4 class="mb-3" style="color: var(--primary);">2. Training Experience</h4>
                                <p class="text-muted mb-0">From complete beginners to advanced lifters, your current experience dictates the complexity of your program. I won't give you exercises you aren't ready for, nor will I hold you back if you know your way around the gym.</p>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="benefit-card h-100" style="padding: 25px; text-align: left;">
                                <h4 class="mb-3" style="color: var(--primary);">3. Health & Injuries</h4>
                                <p class="text-muted mb-0">Your safety is my priority. Knowing about any injuries or health conditions ensures I can adapt your workouts, keeping you pain-free and progressing safely towards your goals without setbacks.</p>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="benefit-card h-100" style="padding: 25px; text-align: left;">
                                <h4 class="mb-3" style="color: var(--primary);">4. Struggles & Mindset</h4>
                                <p class="text-muted mb-0">Be honest about what holds you back—diet, consistency, or motivation. By rating your mindset and identifying your weak points, we can tackle them head-on with effective mindset coaching and sustainable habits.</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Sekcja Formularza (Apply Now) -->
    <section id="form" class="py-5 mb-5 border-top" style="border-color: #222 !important;">
        <div class="container" style="display: flex; align-items: center; justify-content: center;">
            <div class="form-container-box w-100">
    <h2>Step 1: Fill out the application</h2>
    <p class="text-muted mb-3">Please answer the questions honestly. I will review your application and get back to you within 24 hours via WhatsApp or Email.</p>
    
    <!-- Przycisk zapasowy dla osób na telefonach -->
    <div class="d-block d-md-none mb-4">
        <a href="https://docs.google.com/forms/d/e/1FAIpQLScd7VxBZy7IFX3xJeyQqUrHzSICyuDVmSXhWbNrsotmb3pAfQ/viewform" target="_blank" rel="noopener" class="btn btn-neon w-100 py-3 fw-bold">
            Open Form in Full Screen ↗
        </a>
    </div>

    <div class="ratio-iframe">
        <iframe src="https://docs.google.com/forms/d/e/1FAIpQLScd7VxBZy7IFX3xJeyQqUrHzSICyuDVmSXhWbNrsotmb3pAfQ/viewform" frameborder="0" marginheight="0" marginwidth="0" loading="lazy">Loading…</iframe>
    </div>
</div>
        </div>
    </section>
</BaseLayout>