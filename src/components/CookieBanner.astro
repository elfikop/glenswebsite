---
<div id="cookie-banner" class="cookie-overlay">
    <div class="cookie-container">
        <h3>Privacy Policy</h3>
        <p>Our website uses cookies to improve your experience. Do you consent to our data processing according to our <a href="/privacy-policy">Privacy Policy</a>?</p>
        <div class="cookie-btns">
            <button id="cookie-accept" class="cookie-btn-accept">Accept</button>
            <button id="cookie-reject" class="cookie-btn-reject">Decline</button>
        </div>
    </div>
</div>

<script is:inline>
    document.addEventListener("DOMContentLoaded", () => {
        const banner = document.getElementById("cookie-banner");
        const acceptBtn = document.getElementById("cookie-accept");
        const rejectBtn = document.getElementById("cookie-reject");
        
        if (!localStorage.getItem("cookiesAccepted")) {
            if (banner) banner.style.display = "block";
        }

        const hideBanner = () => {
            localStorage.setItem("cookiesAccepted", "true");
            if (banner) banner.style.display = "none";
        };

        if (acceptBtn) acceptBtn.addEventListener("click", hideBanner);
        if (rejectBtn) rejectBtn.addEventListener("click", hideBanner);
    });
    
    function resetCookieConsent(e) {
        e.preventDefault();
        localStorage.removeItem("cookiesAccepted");
        const banner = document.getElementById("cookie-banner");
        if (banner) banner.style.display = "block";
    }
</script>